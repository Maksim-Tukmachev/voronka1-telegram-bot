# Telegram BotFather token — never commit a real value
TELEGRAM_BOT_TOKEN=0000000000:REPLACE_WITH_YOUR_BOT_TOKEN

# Channel the user must join (username with @, or numeric CHANNEL_ID)
CHANNEL_USERNAME=@samartsevvv
# CHANNEL_ID=-1001234567890

# Public link shown on the «Подписаться» URL button
CHANNEL_URL=https://t.me/samartsevvv

# Stub video link delivered after subscription is confirmed
VIDEO_URL=https://example.com/video-stub

# Strategy audit / разбор CTA
AUDIT_URL=https://t.me/power_of_sales

# Seconds after video delivery before the follow-up reminder (default 20 min)
# Use e.g. 60 for local smoke tests
FOLLOWUP_DELAY_SECONDS=1200

# Optional SQLite path for pending follow-ups (default: data/followups.db)
# FOLLOWUP_DB_PATH=data/followups.db
